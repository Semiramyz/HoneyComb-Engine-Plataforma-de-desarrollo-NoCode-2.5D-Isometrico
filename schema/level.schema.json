{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HoneyComb Level",
  "type": "object",
  "required": ["name", "grid", "entities", "events"],
  "properties": {
    "name": { "type": "string" },
    "grid": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "entities": { "type": "array" },
    "events": { "type": "array" }
  }
}
